# --- Server ---
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# --- Database ---
# Local dev (docker-compose): mongodb://localhost:27017/vja_central
# Production: MongoDB Atlas SRV connection string
DATABASE_URL=mongodb://localhost:27017/vja_central

# --- Auth (admin/staff) ---
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Auth (citizen — Praja Samvad) ---
# Must be different secrets from the admin pair above, so citizen and
# admin tokens can never be confused with each other.
JWT_CITIZEN_ACCESS_SECRET=replace-with-a-long-random-citizen-secret
JWT_CITIZEN_REFRESH_SECRET=replace-with-a-different-long-random-citizen-secret
JWT_CITIZEN_ACCESS_EXPIRES_IN=1h
JWT_CITIZEN_REFRESH_EXPIRES_IN=30d

# --- CORS ---
# Comma-separated list of origins allowed to call the API (admin portal URL(s))
ADMIN_ORIGIN=http://localhost:5173

# --- AWS S3 / media storage ---
# Local dev can point these at a MinIO container (S3-compatible) — see docker-compose.yml
AWS_REGION=ap-south-1
AWS_S3_BUCKET=vja-central-media
AWS_S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_FORCE_PATH_STYLE=true
CDN_URL=http://localhost:9000/vja-central-media

# --- Uploads ---
MAX_UPLOAD_MB=15

# --- Firebase (Cloud Messaging) ---
# Leave blank in local dev — push sends will no-op with a warning log
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
CITIZEN_AUTH_RATE_LIMIT_MAX=30
