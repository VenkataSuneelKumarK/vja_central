    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "seed": "tsx src/scripts/seed.ts",
    "seed:grievances": "tsx src/scripts/seedGrievanceConfig.ts"
  },
  "dependencies": {
    "aws-sdk": "^2.1691.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^12.5.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.33.5",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
